{
  "enabled": true,
  "continuous": false,
  "timeoutMs": 15000,
  "monitors": {
    "perception": {
      "appraiser": "system1",
      "threshold": 0.5,
      "escalateAt": 2,
      "commands": [
        {
          "name": "tests",
          "command": "$CHECK",
          "on": [
            "start",
            "edit"
          ],
          "debounceMs": 400,
          "timeoutMs": 120000,
          "serveRunChecks": true
        }
      ],
      "grounding": {
        "mode": "system1",
        "maxLocations": 2,
        "context": 12,
        "threshold": 0.3
      }
    },
    "dives": {
      "mode": "system1",
      "on": [
        "read_file",
        "search"
      ],
      "hops": 2,
      "perHop": 1,
      "candidates": 8,
      "threshold": 0.5,
      "followThreshold": 0.5,
      "maxChars": 6000,
      "viewLines": 60,
      "minViewLines": 1,
      "previewLines": 24,
      "maxHopsPerTask": 16,
      "tests": true
    },
    "coverage": {
      "mode": "always",
      "threshold": 0.5,
      "runCheck": true
    }
  },
  "deliverWaitMs": 120000,
  "followUps": 1
}